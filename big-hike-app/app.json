{
  "expo": {
    "name": "Big Hike",
    "slug": "big-hike-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icons/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1320"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.bighike"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#0B1320"
      },
      "package": "com.example.bighike"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icons/icon.png",
      "name": "Big Hike",
      "shortName": "Big Hike"
    },
    "extra": {
      "eas": {
        "projectId": "50ba5a29-82b9-467a-a1e4-09f229952447"
      }
    }
  }
}
